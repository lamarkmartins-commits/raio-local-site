<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Consolidate HTTP and non-canonical hosts on HTTPS and www.
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} !^www\.raiolocal\.com$ [NC]
  RewriteRule ^ https://www.raiolocal.com%{REQUEST_URI} [R=301,L]

  # Keep the homepage on the canonical root URL.
  RewriteRule ^(?:inicio|index)/?$ / [R=301,L,NC]
  RewriteRule ^index\.html$ / [R=301,L,NC]

  # Retire the former blog index URL; /blog/ is served by blog/.
  RewriteRule ^blog/blog(?:\.html)?/?$ /blog/ [R=301,L,NC]

  # Remove index.html from subdirectory URLs.
  RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html(?:[?\s]) [NC]
  RewriteRule ^(.*/)?index\.html$ /$1 [R=301,L]

  # Redirect duplicate service URLs to their canonical clean URLs.
  RewriteRule ^servicos/criacao-de-sites\.html$ /servicos/criacao-de-sites [R=301,L,NC]
  RewriteRule ^servicos/seo-local-google-mapas\.html$ /servicos/seo-local-google-mapas [R=301,L,NC]
  RewriteRule ^servicos/consultoria-google-perfil-da-empresa\.html$ /servicos/consultoria-google-perfil-da-empresa [R=301,L,NC]
  RewriteRule ^servicos/consultoria-em-usabilidade\.html$ /servicos/consultoria-em-usabilidade [R=301,L,NC]
  RewriteRule ^servicos/site-de-pagina-unica\.html$ /servicos/site-de-pagina-unica [R=301,L,NC]

  # Redirect directly requested .html URLs to their clean equivalents.
  RewriteCond %{THE_REQUEST} !\s/+google952e12c1b55f290e\.html(?:[?\s]) [NC]
  RewriteCond %{THE_REQUEST} \s/+(.+)\.html(?:[?\s]) [NC]
  RewriteRule ^(.+)\.html$ /$1 [R=301,L]

  # Serve matching .html files for clean URLs without changing the browser URL.
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>
